{
  "name": "tigermarkiii",
  "version": "1.0.0",
  "description": "AI-powered bookmark manager with Gemini integration",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mcp": "tsx src/server/mcpServer.ts",
    "build": "vite build",
    "build:ext": "vite build && npm run copy:static",
    "copy:static": "powershell -Command \"Copy-Item 'manifest.json' 'dist/' -Force; Copy-Item '_locales' 'dist/' -Recurse -Force; Copy-Item 'public/icons' 'dist/' -Recurse -Force\"",
    "clean": "powershell -Command \"if (Test-Path 'dist') { Remove-Item 'dist' -Recurse -Force }\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:dark": "eslint . --rule 'dark-mode/require-dark-mode: warn'",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@tanstack/react-virtual": "^3.13.25",
    "d3-force": "^3.0.0",
    "date-fns": "^4.1.0",
    "lru-cache": "^11.2.1",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "ws": "^8.20.1",
    "zustand": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.254",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^3.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.13",
    "eslint": "^10.4.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.2.6",
    "tsx": "^4.22.3",
    "typescript": "^4.9.4",
    "typescript-eslint": "^8.59.4",
    "vite": "^4.1.0",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
